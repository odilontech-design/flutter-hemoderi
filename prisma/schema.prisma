// ─────────────────────────────────────────────────────────────────────────────
// Dilon Saúde | Operações — Hemoderi
//
// Vertical DEDICADA: este banco atende uma operação só, a da Hemoderi. Não há
// coluna de tenant e não deve haver — o contrato (Cláusula 6.1) trata este
// código como solução feita sob medida, e fingir multiempresa aqui só criaria
// um filtro a mais para errar em toda query sem nunca ter um segundo cliente.
//
// O negócio: a Hemoderi coloca PROFISSIONAL e EQUIPAMENTO dentro da clínica do
// cliente. Quem paga é a clínica contratante; quem executa é o profissional
// autônomo. Por isso todo pedido tem dois valores diferentes e independentes —
// o que a clínica deve (a receber) e o que o profissional tem a receber
// (a pagar) — e é essa distância que dá o resultado da operação.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrate usa esta conexão em vez da de cima quando roda `migrate deploy`
  // ou `migrate dev` — precisa ser a direta (sem "-pooler"). Pelo pooler, o
  // advisory lock do Migrate fica preso numa conexão do PgBouncer e trava. O
  // prebuild do package.json roda `migrate deploy` a cada build da Vercel,
  // então sem isto o deploy trava sozinho na primeira migration em produção.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────────────────────
// Acesso
// ─────────────────────────────────────────────────────────────────────────────

/// Os três níveis previstos na proposta. Cada um enxerga só o próprio escopo:
/// o interno vê a operação inteira, a clínica vê os pedidos dela, o
/// profissional vê a agenda e os ganhos dele.
enum PapelUsuario {
  INTERNO // equipe administrativa da Hemoderi
  CLINICA // cliente contratante
  PROFISSIONAL // prestador que executa o atendimento
}

/// Só existe (e só importa) quando papel = INTERNO. Nasceu na reunião de
/// 14/09 como uma distinção só (Atendente/Responsável); a de 21/09 nomeou as
/// quatro funções reais da equipe — a esteira não é mais trabalhada por
/// "atendentes" genéricos, é Joyce alocando, Stephanie conferindo relatório,
/// Ana no comercial e Ingrid gerindo as pessoas.
///
/// RESPONSAVEL continua acima de todos (é o André e a Naiara): as guardas
/// tratam RESPONSAVEL como coringa em qualquer verificação de perfil — ver
/// `perfilPermite` em lib/papeis.ts. ATENDENTE segue existindo como o
/// padrão de quem ainda não tem função definida (import em lote, por
/// exemplo): sem ele, toda conta nova precisaria escolher uma das quatro
/// funções específicas na hora do cadastro, mesmo quando ninguém sabe ainda
/// qual é.
///
/// NULL é tratado como RESPONSAVEL (ver `perfilEfetivo` em lib/papeis.ts) —
/// assim nenhuma conta interna já existente perde acesso quando este campo
/// nasce; a escolha explícita passa a valer só a partir da próxima conta
/// criada ou do primeiro ajuste de perfil.
enum PerfilInterno {
  ATENDENTE // sem função definida — esteira, agenda, cadastros e triagem
  LOGISTICA // Joyce: cadastro, alocação de profissionais, gestão de entregas
  POS_VENDA // Stephanie: financeiro do cliente, pesquisas, aprovação de relatório
  COMERCIAL // Ana: atendimento, preços, agendamento, cancelamento
  GESTAO // Ingrid: pessoas — ganhos, feedbacks e disponibilidade dos profissionais
  RESPONSAVEL // André e Naiara: tudo isso, mais repasse e gestão de acesso
}

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario
  telefone  String?

  /// Só preenchido quando papel = INTERNO. Ver o enum PerfilInterno.
  perfilInterno PerfilInterno?

  /// Preenchido quando papel = CLINICA. É daqui que sai o escopo do portal:
  /// o cliente nunca informa qual clínica é, o vínculo vem da conta.
  clinicaId String?
  clinica   Clinica? @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  /// Preenchido quando papel = PROFISSIONAL, pelo mesmo motivo.
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  criadoEm     DateTime  @default(now())
  /// Desligamento é desativação, nunca exclusão: o usuário está preso ao
  /// histórico (pedidos que abriu, repasses que baixou). Apagar não apaga o
  /// histórico — apaga a autoria dele.
  desativadoEm DateTime?

  /// A senha atual foi gerada pela equipe (criação do acesso ou redefinição)
  /// e ainda não passou pelas mãos do dono. Enquanto for verdade, o sistema
  /// só deixa a pessoa ir para a tela de trocar senha.
  ///
  /// Existe para que ninguém da equipe fique sabendo a senha de ninguém: a
  /// senha gerada serve para a primeira entrada e morre ali. Num sistema que
  /// decide repasse, "o atendente sabe a senha do profissional" não é
  /// detalhe.
  senhaProvisoria Boolean   @default(false)
  /// Quando a pessoa trocou a senha pela última vez — o rastro que responde
  /// "faz quanto tempo que essa senha é a mesma".
  senhaTrocadaEm  DateTime?

  pedidosCriados     Pedido[]            @relation("PedidoCriadoPor")
  avaliacoesCriadas  Avaliacao[]         @relation("AvaliacaoCriadaPor")
  registrosAuditoria RegistroAuditoria[]

  @@index([papel])
  @@index([clinicaId])
  @@index([profissionalId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Parâmetros da operação
// ─────────────────────────────────────────────────────────────────────────────

/// Linha única (id fixo "hemoderi"). O que muda com a operação — janela de
/// lembrete, antecedência mínima do portal, percentual de repasse padrão —
/// mora aqui e não como constante no código, porque isso é ajuste de rotina
/// da equipe e não deve exigir deploy.
model Parametros {
  id   String @id @default("hemoderi")
  nome String @default("Hemoderi")
  cnpj String @default("35.272.539/0001-89")

  /// Número da central usado nos disparos de confirmação e lembrete.
  whatsapp String?
  email    String?

  timezone String @default("America/Sao_Paulo")

  /// Faixa de horário em que a operação aceita agendamento. Serve de limite
  /// externo: a disponibilidade declarada pelo profissional pode ser menor,
  /// nunca maior.
  horaAbertura   String @default("07:00")
  horaFechamento String @default("19:00")

  /// Antecedência mínima, em horas, para a clínica agendar sozinha pelo
  /// portal. Sem isso o portal aceita pedido para daqui a 20 minutos e a
  /// operação descobre quando não tem mais como alocar ninguém.
  antecedenciaMinimaHoras Int @default(24)

  /// Quantas horas antes do atendimento o lembrete é disparado.
  horasLembrete Int @default(24)

  /// Quantas horas antes do atendimento o profissional passa a ver a clínica
  /// e o doutor.
  ///
  /// Antes disso ele vê só data, horário, serviço e quanto recebe. É uma
  /// decisão de imparcialidade da operação (ata de 14/09): sabendo o endereço
  /// com antecedência, atendimento longe é recusado e sobra sempre para os
  /// mesmos. Como ele precisa saber onde ir, a informação não some — ela
  /// aparece junto com o lembrete, com tempo de se organizar.
  horasRevelarLocal Int @default(24)

  /// Repasse padrão do profissional, em % do valor do serviço. É o piso da
  /// cadeia de regras (ver lib/repasse.ts) — vale quando nem o serviço nem o
  /// profissional definem regra própria.
  repassePercentPadrao Float @default(60)

  /// Prazo padrão de vencimento da fatura da clínica, em dias após o
  /// fechamento do mês.
  prazoFaturamentoDias Int @default(10)

  /// Numeração humana dos pedidos. A equipe fala "pedido 412" no WhatsApp;
  /// ninguém dita um cuid por telefone.
  proximoNumeroPedido Int @default(1)
  proximoNumeroFatura Int @default(1)

  atualizadoEm DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Cadastros
// ─────────────────────────────────────────────────────────────────────────────

/// A clínica contratante — o cliente que paga. Não confundir com paciente:
/// o paciente é de quem contrata, a Hemoderi atende a clínica.
model Clinica {
  id       String  @id @default(cuid())
  nome     String
  /// Usado no link público de agendamento e no QR Code de divulgação:
  /// /portal/agendar/clinica-santa-rita
  slug     String  @unique
  cnpj     String?
  telefone String?
  email    String?

  /// Registro no conselho de classe do responsável (CRO, CRM, CRBM…) — a régua
  /// mínima de identificação, o equivalente ao CPF/CNPJ (ata de 05/10).
  /// Obrigatório no autocadastro; opcional no momento do agendamento.
  conselho         String?
  registroConselho String?

  /// Logradouro, bairro, cidade e UF vêm da consulta por CEP e não são
  /// digitados: endereço escrito à mão é o que faz o profissional rodar
  /// quarteirão atrás de uma clínica cadastrada com o nome da rua errado.
  /// Número e complemento a consulta não tem como saber — esses ficam livres.
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  cep         String?

  /// Quantos atendimentos a clínica comporta ao mesmo tempo. Não é detalhe
  /// de cadastro: é o que permite alocar dois profissionais no mesmo horário
  /// no mesmo endereço sem que isso seja conflito (a clínica do briefing tem
  /// 10 salas). Sem esse número, ou o sistema bloqueia agendamento legítimo
  /// ou aceita mais gente do que cabe na sala.
  salas Int @default(1)

  /// Como esta clínica paga, como regra: antecipado ou depois do
  /// procedimento. Informação INTERNA da equipe (ata de 28/09) — a clínica
  /// não vê isto no portal dela. Serve de padrão na hora de preencher a
  /// condição de cada pedido, que continua podendo divergir caso a caso.
  condicaoPagamento String?

  observacoes String?

  /// Perfis APROVADOS do cliente (ata de 01/10): decidem quais serviços ele vê
  /// no catálogo e quais tabelas de preço podem ser vinculadas. Mais de um
  /// perfil é normal — o dentista que também dá curso. Vazio é o cadastro
  /// legado, anterior à classificação: vê o que não é restrito a perfil.
  perfis PerfilCliente[] @default([])

  /// O que o próprio cliente disse ser no autocadastro. Só a equipe promove
  /// isto a `perfis` — nove em cada dez dentistas também lecionam, e deixar o
  /// cliente escolher a própria tabela de preço seria desconto por
  /// autodeclaração.
  perfilDeclarado PerfilCliente?

  /// Triagem do cadastro. Cadastro feito pela equipe nasce APROVADO; o
  /// autocadastro nasce PENDENTE e só agenda depois de revisado.
  statusCadastro     StatusCadastro @default(APROVADO)
  autocadastro       Boolean        @default(false)
  cadastroRevisadoEm DateTime?

  ativa        Boolean   @default(true)
  criadaEm     DateTime  @default(now())
  atualizadaEm DateTime  @updatedAt
  desativadaEm DateTime?

  usuarios     Usuario[]
  precos       PrecoClinica[]
  /// Tabelas de preço liberadas para esta clínica — uma ou várias.
  tabelas      TabelaPreco[]
  /// Endereços de atendimento ALÉM do principal (que mora nas colunas
  /// acima). Cada pedido aponta para o seu.
  enderecos    EnderecoClinica[]
  pedidos      Pedido[]
  faturas      Fatura[]
  avaliacoes   Avaliacao[]
  solicitacoes SolicitacaoPublica[]
  pesquisasNps PesquisaNps[]

  @@index([ativa])
}

/// NPS de baixa frequência (reunião de 14/09): a cada 60 dias, para a
/// clínica que NÃO teve múltiplos atendimentos nesse período — o objetivo é
/// ouvir quem está esfriando, não bater palmas para quem já usa bastante e
/// cuja satisfação a taxa de uso já denuncia sozinha. A janela fica gravada
/// na própria pesquisa para a rotina nunca gerar duas para o mesmo período.
model PesquisaNps {
  id String @id @default(cuid())

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  /// Início e fim dos 60 dias avaliados — não da pesquisa em si, que pode ser
  /// respondida dias depois de gerada.
  janelaInicio DateTime
  janelaFim    DateTime

  /// Quantos atendimentos REALIZADOs a clínica teve na janela. Guardado para
  /// auditoria: "por que essa clínica recebeu NPS" tem resposta sem precisar
  /// reconstruir o histórico de pedidos daquela época.
  atendimentosNoPeriodo Int

  /// 0 a 10, escala clássica de NPS. NULL enquanto pendente de resposta.
  nota Int?

  pontosPositivos          String?
  expectativasNaoAtendidas String?
  sugestoes                String?

  criadaEm     DateTime  @default(now())
  respondidaEm DateTime?

  /// Uma pesquisa por clínica por janela — a rotina roda todo dia, e sem
  /// isso rodar duas vezes no mesmo período criaria pesquisa duplicada.
  @@unique([clinicaId, janelaInicio])
  @@index([clinicaId, respondidaEm])
}

model Servico {
  id        String           @id @default(cuid())
  nome      String
  descricao String?
  /// O detalhamento técnico do serviço (ata de 05/10): o que está incluso, como
  /// funciona. Aparece no botão "mais detalhes" do catálogo do cliente e no
  /// aceite do profissional; a `descricao` continua sendo o resumo do card.
  detalhes  String?
  categoria CategoriaServico

  /// Duração cheia do atendimento, incluindo preparo. É ela que define o
  /// bloco na agenda do profissional e o cálculo de conflito — não o horário
  /// de início sozinho.
  duracaoMin Int @default(60)

  /// Preço de tabela cobrado da clínica. Uma clínica com preço negociado
  /// sobrescreve este valor em PrecoClinica. Zero não é "grátis": é "tabela
  /// ainda não precificada" — o catálogo comercial nasce sem preço público
  /// porque o modelo é negociado por clínica.
  valorPadraoCentavos Int @default(0)

  /// Regra de repasse do serviço. Preenchida só quando o serviço foge do
  /// padrão da operação — por exemplo, procedimento em que a Hemoderi banca
  /// o insumo e por isso repassa menos.
  repassePercent      Float?
  repasseFixoCentavos Int?

  /// Agrupamento comercial — PRF, Piezo, Laser. Ortogonal à categoria: "PRF"
  /// aparece em odontologia, estética e saúde, e é assim que a operação fala
  /// dos serviços. Vazio, o sistema infere do nome (lib/familia.ts), para a
  /// vitrine pública não nascer com dezoito itens soltos.
  familia String?

  /// Serviço que só acontece com equipamento da Hemoderi em campo. Quando
  /// verdadeiro, alocar o pedido exige reservar um equipamento livre.
  exigeEquipamento Boolean @default(false)

  /// Exceção ao de cima: o aparelho existe de sobra (ou é o próprio
  /// profissional que leva o dele). O serviço continua exigindo equipamento,
  /// mas NÃO consome uma unidade do estoque ao alocar — sem isso, um item
  /// abundante limita a agenda como se fosse escasso.
  equipamentoIlimitado Boolean @default(false)

  /// QUAL equipamento o serviço exige, pelo campo Equipamento.tipo — não
  /// basta "algum equipamento livre": um AirFlow não substitui um laser
  /// LiteTouch. Nulo com exigeEquipamento=true cai no comportamento antigo
  /// (qualquer equipamento disponível), útil só enquanto o parque de
  /// equipamentos ainda não tem o tipo cadastrado.
  tipoEquipamento String?

  /// Em que o preço é cobrado: por paciente, por período ou por hora (ata de
  /// 01/10). É o que a tela escreve ao lado do valor ("R$ 450 / hora") e o que
  /// diz o que a quantidade significa.
  unidadeCobranca UnidadeCobranca @default(PACIENTE)

  /// Serviço com quantidade variável — Light Touch cobra por dente tratado ou
  /// por paciente. Falso é o caso do PRF: um por paciente, e para outro
  /// paciente é OUTRO agendamento, não um "2" no campo de quantidade.
  permiteQuantidade Boolean @default(false)
  /// O que se conta: "dentes", "pacientes". Aparece ao lado do campo.
  rotuloQuantidade  String?
  quantidadeMaxima  Int?
  /// Menor quantidade que se vende. O ultrassom cobra no mínimo 400 disparos
  /// por paciente: a tela já começa nele, e abaixo disso o servidor recusa.
  quantidadeMinima  Int     @default(1)

  /// Franquia: o preço do serviço COBRE até esta quantidade (LiteTouch: R$ 750
  /// até 2 elementos; ultrassom: R$ 990 até 400 disparos). Acima dela, cada
  /// unidade soma `valorAdicionalCentavos`. Nulo = sem franquia: o preço é
  /// por unidade e o total é preço × quantidade.
  quantidadeIncluida     Int?
  valorAdicionalCentavos Int  @default(0)

  /// Perfis de cliente que enxergam o serviço. Vazio = todos. É como "PRF
  /// curso" fica restrito a quem tem perfil de curso sem esconder o resto.
  perfis           PerfilCliente[] @default([])
  /// UFs em que a Hemoderi NÃO atende o serviço (o laser CO2 não roda no Rio).
  /// Some do catálogo e do agendamento de quem está lá, em vez de virar
  /// cancelamento depois.
  ufsIndisponiveis String[]        @default([])

  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  desativadoEm DateTime?

  precos                PrecoClinica[]
  precosTabela          PrecoTabela[]
  precosRegiao          PrecoRegiao[]
  solicitacoes          SolicitacaoPublica[]
  regrasRepasse         RegraRepasse[]
  pedidos               Pedido[]
  adicionaisDeRelatorio RelatorioServicoAdicional[]
  aptos                 Profissional[]              @relation("ServicosAptosDoProfissional")
  realizadoEmRelatorios RelatorioAtendimento[]      @relation("ServicoRealizadoNoRelatorio")

  @@index([ativo])
  @@index([categoria])
}

enum UnidadeCobranca {
  PACIENTE
  PERIODO
  HORA
}

/// Quem é o cliente, comercialmente. Define o que ele enxerga e a que tabela
/// de preço tem direito. ODONTOLOGIA, MEDICINA e ESTETICA são as únicas
/// escolhas do autocadastro; CURSO, MANDIC e PARCEIRO só a equipe atribui.
enum PerfilCliente {
  ODONTOLOGIA
  MEDICINA
  ESTETICA
  CURSO
  MANDIC
  PARCEIRO
}

enum StatusCadastro {
  PENDENTE
  APROVADO
  RECUSADO
}

/// Endereço de atendimento adicional de uma clínica — o "casa / trabalho" dos
/// aplicativos de entrega. O principal fica nas colunas da própria Clinica;
/// pedido sem `enderecoId` acontece nele.
model EnderecoClinica {
  id String @id @default(cuid())

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  /// Como a clínica chama o lugar: "Unidade Moema", "Consultório do Rio".
  rotulo String

  cep         String
  endereco    String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String

  /// Referências para quem vai até lá (ata de 02/10): "entrada de serviço
  /// pelos fundos", "bloco B, sala 12". UM campo de texto livre, de propósito:
  /// a ideia de múltipla escolha (estacionamento, acessibilidade) foi
  /// recusada porque faria o profissional deixar de conferir o endereço.
  observacoes String?

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  pedidos Pedido[]

  @@index([clinicaId])
}

/// Uma tabela de preço comercial — "Consultório particular", "Cursos",
/// "Mandic". Diferente da praça (que varia por lugar), a tabela varia por
/// QUEM compra. Uma clínica pode ter várias liberadas: o dentista que também
/// dá curso enxerga o preço de cada serviço na tabela que lhe cabe.
model TabelaPreco {
  id        String         @id @default(cuid())
  nome      String         @unique
  descricao String?
  /// Para quem a tabela foi pensada — só um rótulo para organizar a lista.
  perfil    PerfilCliente?

  ativa        Boolean  @default(true)
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  itens    PrecoTabela[]
  clinicas Clinica[]
}

model PrecoTabela {
  id String @id @default(cuid())

  tabelaId String
  tabela   TabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  valorCentavos Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tabelaId, servicoId])
  @@index([tabelaId])
}

/// As três frentes do catálogo comercial da Hemoderi — a própria empresa
/// organiza a divulgação assim (site e catálogo do WhatsApp), e é a divisão
/// que faz sentido para relatório: cada área tem público, sazonalidade e
/// margem diferentes.
enum CategoriaServico {
  ODONTOLOGIA
  ESTETICA
  SAUDE
}

/// Uma praça de preço — "São Paulo e região", "Interior", "Outros estados".
///
/// Nasceu da ata de 28/09: o mesmo procedimento não custa o mesmo em toda
/// parte, e sem uma tabela por praça a alternativa era negociar clínica por
/// clínica desde a primeira (PrecoClinica), o que não escala e faz o preço da
/// vitrine depender de alguém ter lembrado de cadastrar.
///
/// A praça é definida por UF porque é o recorte que o cadastro já tem — o
/// endereço vem do CEP, e a UF vem junto. "São Paulo e arredores até 150 km",
/// que o André citou, não é representável por UF sozinha: quando essa
/// distinção fizer falta, ela entra como uma praça própria com as UFs que a
/// compõem, ou como preço negociado da clínica, que continua vencendo tudo.
model RegiaoPreco {
  id   String @id @default(cuid())
  nome String @unique

  /// As UFs que caem nesta praça. Uma UF mora em uma praça só — duas praças
  /// reivindicando o mesmo estado tornariam o preço da clínica ambíguo, e o
  /// cadastro recusa a sobreposição por isso.
  ufs String[]

  ativa        Boolean  @default(true)
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  precos PrecoRegiao[]

  @@index([ativa])
}

/// Preço de um serviço numa praça. Fica ENTRE o preço negociado da clínica e
/// o preço de tabela do serviço: quem tem negociação usa a dela, quem não tem
/// usa a da praça, e quem não tem praça cai na tabela.
model PrecoRegiao {
  id String @id @default(cuid())

  regiaoId String
  regiao   RegiaoPreco @relation(fields: [regiaoId], references: [id], onDelete: Cascade)

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  valorCentavos Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([regiaoId, servicoId])
  @@index([regiaoId])
}

/// Preço negociado de um serviço para uma clínica específica. A tabela de
/// preço não é por cliente inteiro nem global: é por par clínica × serviço,
/// que é como a negociação acontece de fato.
model PrecoClinica {
  id String @id @default(cuid())

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  valorCentavos Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clinicaId, servicoId])
  @@index([clinicaId])
}

enum StatusEquipamento {
  DISPONIVEL
  EM_USO
  MANUTENCAO
  INATIVO
}

/// O equipamento que vai junto com o profissional. Ele é um recurso finito:
/// dois atendimentos no mesmo horário precisam de dois aparelhos, e é isso
/// que a alocação verifica antes de confirmar.
model Equipamento {
  id         String  @id @default(cuid())
  nome       String
  /// Casa com Servico.tipoEquipamento — é o que a alocação usa para reservar
  /// o aparelho certo, não só "algum aparelho livre".
  tipo       String?
  /// Número de patrimônio/série. Único porque é assim que a equipe identifica
  /// o aparelho quando ele volta com defeito.
  patrimonio String? @unique

  status      StatusEquipamento @default(DISPONIVEL)
  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pedidos Pedido[]

  @@index([status])
  @@index([tipo])
}

/// O prestador. Trabalha em modelo de disponibilidade declarada (gig): não
/// tem jornada fixa, informa quando pode atender e recebe por atendimento
/// realizado.
model Profissional {
  id       String  @id @default(cuid())
  nome     String
  cpf      String? @unique
  telefone String?
  email    String? @unique

  /// Conselho e registro profissional (ex.: "COREN-SP", "123456"). Fica no
  /// cadastro porque a clínica contratante pode exigir a comprovação.
  conselho      String?
  registro      String?
  especialidade String?

  /// Chave PIX para o repasse. É o único dado bancário guardado — evita
  /// manter agência e conta sem necessidade.
  chavePix String?

  /// Agenda do Google onde os atendimentos dele são publicados — normalmente
  /// o e-mail da conta Google, depois que ele compartilha a própria agenda
  /// com a conta de serviço da Hemoderi dando permissão de alterar eventos.
  ///
  /// É o que faz o compromisso aparecer no celular DELE, com o lembrete dele,
  /// em vez de numa agenda da operação que ele teria que ir consultar. Vazio
  /// cai na agenda da operação (GOOGLE_AGENDA_ID): ninguém fica sem evento
  /// por não ter conectado a agenda.
  googleAgendaId String?

  /// Regra de repasse do profissional, em % do valor do serviço. Vence o
  /// padrão da operação e perde para a regra do serviço e para uma
  /// RegraRepasse específica — a cadeia inteira está em lib/repasse.ts.
  repassePercentPadrao Float?

  /// Valor fixo por atendimento, em centavos. Vence o percentual acima: a
  /// operação decidiu pagar valor fechado, não fatia do que a clínica paga.
  /// Fica ao lado do percentual (em vez de substituí-lo) para que um acerto
  /// antigo continue legível quando alguém for conferir um mês fechado.
  repasseFixoCentavos Int?

  /// Onde o profissional atende de fato — não o endereço de cadastro, a
  /// praça que decide a régua de repasse. A ata de 21/09 citou exatamente
  /// isso: "os repasses variam entre o estado de São Paulo e demais
  /// estados". Sigla (SP, RJ...), sem validação rígida de lista — a
  /// operação lida com estado nenhum quando não sabe ainda.
  uf String?

  /// O grupo que decide o repasse quando o profissional não tem um acerto
  /// próprio (RegraRepasse) nem valor/percentual individual — ver
  /// lib/repasse.ts. Existe separado de `uf` porque a ata pediu grupos
  /// PARA CATEGORIZAÇÃO, não uma regra fixa amarrada ao estado: São Paulo
  /// hoje, tempo de experiência amanhã, sem precisar de coluna nova a cada
  /// critério novo — só um grupo novo.
  grupoRepasseId String?
  grupoRepasse   GrupoRepasse? @relation(fields: [grupoRepasseId], references: [id], onDelete: SetNull)

  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  desativadoEm DateTime?

  /// Os serviços que ele está apto a prestar (ata de 02/10). É o que filtra a
  /// lista de quem pode ser alocado a cada serviço. VAZIO = ainda não
  /// configurado: o profissional legado continua alocável a tudo até a equipe
  /// definir, em vez de sumir de todas as listas de um dia para o outro.
  servicosAptos Servico[] @relation("ServicosAptosDoProfissional")

  usuarios         Usuario[]
  disponibilidades Disponibilidade[]
  bloqueios        Bloqueio[]
  regrasRepasse    RegraRepasse[]
  pedidos          Pedido[]
  relatorios       RelatorioAtendimento[]
  repasses         Repasse[]
  avaliacoes       Avaliacao[]
  recusas          RecusaAtendimento[]

  @@index([ativo])
  @@index([grupoRepasseId])
}

/// Repasse combinado para um profissional em um serviço específico. É a
/// exceção negociada caso a caso; a resolução completa está em lib/repasse.ts.
model RegraRepasse {
  id String @id @default(cuid())

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  percent      Float?
  fixoCentavos Int?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@unique([profissionalId, servicoId])
  @@index([profissionalId])
}

/// Um degrau de repasse compartilhado por vários profissionais — a ata de
/// 21/09 pediu "múltiplos grupos e categorizações", começando por região
/// (São Paulo paga diferente dos demais estados). Fica ENTRE o profissional
/// e o padrão da operação na cadeia de lib/repasse.ts: mais específico que
/// "toda a operação", mais genérico que "este profissional".
///
/// Um grupo por nome, não uma coluna de UF na regra: assim o próximo
/// critério (tempo de experiência, por exemplo) é só outro grupo, sem
/// mexer no schema de novo.
model GrupoRepasse {
  id   String @id @default(cuid())
  nome String @unique

  percent      Float?
  fixoCentavos Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  profissionais Profissional[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Agenda do profissional
// ─────────────────────────────────────────────────────────────────────────────

/// Janela semanal recorrente que o profissional declara no portal dele.
/// A meta do briefing — "o profissional disponibiliza a própria agenda" —
/// depende disto: sem declaração, a alocação vira telefonema.
model Disponibilidade {
  id String @id @default(cuid())

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  /// 0 = domingo … 6 = sábado, igual a Date#getUTCDay.
  diaSemana  Int
  horaInicio String // "08:00"
  horaFim    String // "12:00"

  criadaEm DateTime @default(now())

  @@index([profissionalId, diaSemana])
}

/// Ausência pontual, que vence a disponibilidade recorrente. Sem hora
/// preenchida, bloqueia o dia inteiro.
model Bloqueio {
  id String @id @default(cuid())

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  data       DateTime
  horaInicio String?
  horaFim    String?
  motivo     String?

  criadoEm DateTime @default(now())

  @@index([profissionalId, data])
}

// ─────────────────────────────────────────────────────────────────────────────
// Esteira do pedido
// ─────────────────────────────────────────────────────────────────────────────

/// O ciclo de vida completo, ponta a ponta.
///
/// SOLICITADO nasce do portal da clínica e ainda não é compromisso: a equipe
/// confirma. CONFIRMADO é compromisso assumido sem dono. ALOCADO tem
/// profissional (e equipamento, quando o serviço exige) reservado. O
/// resultado — REALIZADO ou FALTOU — vem do relatório pós-atendimento, e é
/// só ele que gera repasse: falta não paga.
enum StatusPedido {
  SOLICITADO
  CONFIRMADO
  ALOCADO
  REALIZADO
  FALTOU
  CANCELADO
}

/// De onde veio o pedido. O contrato prevê agendamento híbrido, e separar a
/// origem é o que mostra se o autoatendimento está de fato tirando trabalho
/// manual da equipe ou se virou mais um canal para conferir.
enum OrigemPedido {
  INTERNO
  PORTAL_CLINICA
}

model Pedido {
  id     String @id @default(cuid())
  /// Referência humana, sequencial. A equipe fala "pedido 412"; ninguém dita
  /// um cuid por telefone.
  numero Int    @unique

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id])

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])

  /// Quem vai atender. Em SOLICITADO é o profissional que a clínica pediu no
  /// portal — reserva provisória, que já segura o horário dele; em ALOCADO é
  /// compromisso assumido pela equipe. O status é o que separa os dois.
  /// Nulo enquanto ninguém foi indicado: é a fila de trabalho da equipe.
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])

  equipamentoId String?
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])

  /// Onde acontece, quando NÃO é o endereço principal da clínica.
  enderecoId String?
  endereco   EnderecoClinica? @relation(fields: [enderecoId], references: [id])

  /// Quantas unidades do serviço (dentes, pacientes, horas), quando o serviço
  /// permite quantidade. `valorServicoCentavos` já é o total — preço unitário
  /// vezes isto.
  quantidade Int @default(1)

  /// Pedidos criados no MESMO agendamento do portal (vários serviços numa
  /// visita só). Só liga; cada serviço continua sendo um pedido, porque é
  /// como a operação aloca, cobra e repassa.
  grupoId String?

  /// Meia-noite UTC do dia do atendimento. Hora fica separada, em texto, pelo
  /// mesmo motivo de lib/data.ts: o dia do atendimento não pode escorregar
  /// porque o servidor da Vercel roda em UTC e a operação é no Brasil.
  data       DateTime
  horaInicio String
  /// Congelada do serviço no momento da criação: mudar a duração do serviço
  /// depois não pode reescrever a agenda de quem já está marcado.
  duracaoMin Int

  status StatusPedido @default(SOLICITADO)
  origem OrigemPedido @default(INTERNO)

  /// Valor cobrado da clínica, congelado na criação — pelo mesmo motivo da
  /// duração: reajuste de tabela não reescreve o que já foi combinado.
  valorServicoCentavos Int @default(0)
  /// Valor devido ao profissional, congelado na alocação. Fica no pedido
  /// além de no repasse porque a alocação acontece antes do atendimento e a
  /// equipe precisa saber o custo antes de fechar o mês.
  valorRepasseCentavos Int @default(0)

  /// Identificação mínima do paciente, só o necessário para a clínica
  /// reconhecer o atendimento na agenda dela. Dado de saúde não entra aqui:
  /// a Hemoderi é controladora (LGPD, Cláusula 8) e quanto menos dado
  /// pessoal circular no sistema de logística, menor a superfície.
  pacienteNome    String?
  pacienteContato String?

  /// Quem pediu o procedimento dentro da clínica. A clínica é a contratante;
  /// o doutor é a pessoa que responde pelo caso, e é por ele que a equipe
  /// pergunta ao telefone — "o pedido da doutora Marina", não "o pedido 412".
  doutorNome String?

  /// Contato da CLÍNICA para a central confirmar o agendamento (ata de 05/10)
  /// — quem atende o telefone lá, não o paciente.
  contatoClinica String?

  /// O procedimento que o doutor fará NO PACIENTE ("Implante", "Enxerto
  /// ósseo"…), escolhido numa lista na última etapa do agendamento (ata de
  /// 02/10). Não é o serviço contratado da Hemoderi: é a informação que
  /// alimenta a inteligência de oferta de novos serviços. "Outros" guarda o
  /// texto digitado.
  procedimentoPaciente String?

  /// Como o CLIENTE vai pagar: Pix, dinheiro ou cheque, escolhido por ele no
  /// agendamento (ata de 02/10). Diferente de `condicaoPagamento`, que é o
  /// acordo interno da operação com a clínica e o cliente não vê.
  formaPagamento String?

  /// Como esta clínica paga ESTE atendimento: antecipado, na hora, faturado.
  /// Preenchido à mão pela equipe, porque depende do histórico de cada
  /// clínica e não de uma regra que o sistema consiga inferir.
  condicaoPagamento String?

  observacoes String?

  /// Ids do que foi criado fora daqui, guardados para não duplicar em uma
  /// segunda sincronização e para permitir atualizar o evento existente.
  googleEventoId     String?
  /// EM QUAL agenda o evento acima foi criado. Sem isto, trocar o
  /// profissional de um atendimento deixaria o evento na agenda do
  /// profissional antigo para sempre: o id do evento só é endereçável junto
  /// com o id da agenda que o contém, e "some da minha agenda quando me
  /// tiram do caso" é o mínimo para alguém confiar no que vê ali.
  googleAgendaId     String?
  pipedriveNegocioId String?

  faturaId String?
  fatura   Fatura? @relation(fields: [faturaId], references: [id])

  criadoPorId String?
  criadoPor   Usuario? @relation("PedidoCriadoPor", fields: [criadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  canceladoEm        DateTime?
  motivoCancelamento String?

  /// Quando o profissional confirmou que assume ESTE atendimento.
  ///
  /// A ata de 21/09 separou alocar de aceitar: a logística indica, a pessoa
  /// confirma. Depois de confirmado ela não recusa mais sozinha — tirar do
  /// caso passa a ser exclusividade da logística (`desalocarPedido`), que
  /// zera este campo para o próximo profissional ter de confirmar de novo.
  /// Nulo em pedido alocado = esperando resposta de quem vai atender.
  aceitoEm DateTime?

  /// Chegada ao local, registrada pelo profissional no botão de check-in.
  ///
  /// Separado da localização do RELATÓRIO de propósito: o relatório é
  /// enviado no fim (às vezes já no carro, às vezes em casa), e "estava no
  /// endereço na hora marcada" é outra pergunta. Nulo é normal — sem
  /// permissão de GPS o check-in ainda acontece, só sem coordenada.
  checkinEm             DateTime?
  checkinLatitude       Float?
  checkinLongitude      Float?
  checkinPrecisaoMetros Float?

  /// Por que a chegada passou do horário (ata de 28/09). Só é pedida quando
  /// o check-in acontece depois da tolerância — e NUNCA trava o check-in:
  /// o botão existe para a clínica saber que alguém vem, e exigir texto
  /// para registrar a chegada atrasaria justamente o aviso que resolve o
  /// desencontro. Vazio quer dizer "chegou tarde e não disse por quê", que
  /// é um dado útil por si só no relatório de atrasos.
  checkinJustificativa String?

  relatorio   RelatorioAtendimento?
  repasse     Repasse?
  avaliacao   Avaliacao?
  solicitacao SolicitacaoPublica?
  mensagens   MensagemWhatsapp[]
  recusas     RecusaAtendimento[]

  @@index([data, status])
  @@index([clinicaId, data])
  @@index([profissionalId, data])
  @@index([status])
  @@index([faturaId])
  @@index([grupoId])
}

/// Recusa de uma alocação, ANTES do aceite.
///
/// Fica numa tabela própria em vez de um campo no pedido porque o pedido
/// volta para a fila e é alocado de novo: guardar no próprio pedido
/// apagaria a recusa anterior a cada rodada, e é justamente a série
/// ("quantos aceitou, quantos recusou, por quê") que a ata de 21/09 pediu
/// para acompanhar.
model RecusaAtendimento {
  id String @id @default(cuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  /// Opcional desde a ata de 28/09: André decidiu que exigir justificativa
  /// para recusar trava quem está de fato indisponível e ainda enche a base
  /// de "não posso" digitado só para o botão liberar. A série de recusas é o
  /// que a operação acompanha — o texto é bônus, não pré-requisito.
  motivo   String?
  criadaEm DateTime @default(now())

  @@index([profissionalId, criadaEm])
  @@index([pedidoId])
}

/// O relatório que o profissional preenche depois do atendimento. É o
/// documento que fecha o pedido e a única origem do repasse — sem relatório
/// não há valor a pagar, e é por isso que ele é a primeira tela do portal do
/// profissional.
model RelatorioAtendimento {
  id String @id @default(cuid())

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  /// Falso = paciente não compareceu. Segue registrado (o deslocamento
  /// aconteceu) mas não gera repasse automático; se a operação decidir pagar
  /// a falta, o valor é lançado à mão e fica visível como exceção.
  compareceu Boolean @default(true)

  inicioReal String?
  fimReal    String?
  /// Quantos procedimentos foram feitos, quando o serviço é cobrado por
  /// volume e não por sessão.
  quantidade Int     @default(1)

  intercorrencia Boolean @default(false)
  observacoes    String?

  /// Sinais vitais do modelo de relatório que o André mandou na reunião de
  /// 21/09. São TEXTO, não número: a decisão da reunião foi campo obrigatório
  /// com botão "não se aplica" (ver lib/relatorio.ts), e "não se aplica" não
  /// cabe num Int. Também evita fingir precisão — "12/8" e "120x80" são a
  /// mesma pressão escrita de dois jeitos, e normalizar isso sozinho seria
  /// inventar dado clínico.
  ///
  /// ATENÇÃO, LGPD: até aqui o sistema não guardava dado de saúde — só
  /// identificação mínima do paciente (ver Pedido.pacienteNome). Estes
  /// campos mudam isso, a pedido da operação. A Hemoderi é a controladora
  /// (Cláusula 8) e o prazo de retenção continua em aberto (pergunta 37 do
  /// questionário técnico): enquanto não houver resposta, não há rotina de
  /// expurgo e o dado fica.
  frequenciaCardiaca String?
  saturacaoOxigenio  String?
  pressaoArterial    String?
  glicemia           String?
  /// Óxido nitroso e oxigênio — só fazem sentido em sedação, e é para esses
  /// que o "não se aplica" existe na maior parte dos atendimentos.
  oxidoNitroso       String?
  oxigenio           String?

  /// O que foi executado além (ou no lugar) do serviço contratado — a
  /// membrana que virou stickybone. Quem declara é quem atendeu; quem
  /// valida é o pós-venda, e é por isso que a aprovação tem uma validação
  /// separada só para serviço.
  servicosAdicionais String?

  /// O agendamento como ele ACONTECEU, quando divergiu do que foi marcado
  /// (ata de 28/09). O atendimento sai num endereço que a clínica mudou na
  /// véspera, quem recebe é outro doutor, a unidade é a filial — e hoje
  /// isso só existia como observação solta, quando existia.
  ///
  /// São CORREÇÕES DO RELATÓRIO, não edição do cadastro: gravar direto na
  /// Clinica deixaria um profissional renomear a clínica para todo mundo, e
  /// um endereço trocado em campo não deve reescrever a base que a logística
  /// usa para alocar os próximos. A equipe vê a divergência ao conferir e
  /// decide se o cadastro muda.
  ///
  /// Nulo é o normal: significa "saiu como estava marcado". Só é preenchido
  /// quando o profissional de fato altera o campo.
  clinicaNomeInformado String?
  enderecoInformado    String?
  doutorNomeInformado  String?

  /// Deslocamento. Não é tabelado: a régua é até 150km, mas varia por
  /// quilometragem excedente e por tipo de transporte (moto x carro), então
  /// entra caso a caso e passa por validação própria na aprovação.
  ajudaCustoCentavos      Int?
  ajudaCustoJustificativa String?

  /// Onde o navegador do profissional estava ao enviar o relatório — pedida
  /// no momento do envio, nunca antes. Confirma presença no local sem
  /// travar o relatório: sem permissão, sem GPS, sem sinal, o relatório
  /// segue enviado do mesmo jeito e os três campos ficam nulos.
  latitude       Float?
  longitude      Float?
  precisaoMetros Float?

  /// O que o profissional recebeu da clínica NO ATO (ata de 05/10). Nulo =
  /// relatório anterior ao bloco financeiro; "NAO", "TOTAL" ou "PARCIAL".
  /// Forma (PIX, DINHEIRO, CHEQUE, CARTAO) e valor exato só existem quando
  /// houve recebimento; o comprovante, quando a forma deixa rastro.
  recebimento           String?
  formaRecebimento      String?
  valorRecebidoCentavos Int?
  comprovante           ComprovanteRecebimento?

  /// A chave PIX que o profissional confirma NO relatório, que pode ser
  /// diferente da do cadastro (conta nova, chave trocada). É a que vale para
  /// este repasse: conferir no ato evita o pagamento devolvido três dias
  /// depois.
  chavePixConfirmada String?

  enviadoEm DateTime @default(now())

  /// O relatório é do profissional, mas o repasse é dinheiro da operação:
  /// alguém da equipe confere e aprova. Enquanto não houver aprovação, o
  /// repasse não nasce — é o que impede pagar por um atendimento que a
  /// clínica ainda vai contestar.
  aprovadoEm    DateTime?
  aprovadoPorId String?

  /// As três conferências que a aprovação geral exige (ata de 21/09).
  ///
  /// Separadas porque é isso que o pós-venda realmente faz: bate o serviço
  /// executado contra o contratado, bate o valor, e decide a ajuda de custo
  /// — três perguntas com respostas independentes. Um botão só de "aprovar"
  /// transformaria as três num clique que ninguém lê.
  servicoValidadoEm    DateTime?
  valorValidadoEm      DateTime?
  ajudaCustoValidadaEm DateTime?

  /// O pós-venda recusou o relatório e o devolveu ao profissional para
  /// corrigir. Enquanto `devolvidoEm` está preenchido, o relatório NÃO está na
  /// fila de conferência — a bola é do profissional. Reenviar limpa os três
  /// campos e o relatório volta para a conferência. Aprovar nunca passa por
  /// aqui: só relatório sem devolução pendente é aprovável.
  devolvidoEm     DateTime?
  motivoDevolucao String?
  devolvidoPorId  String?

  /// O serviço principal que de fato foi feito, quando diferente do agendado
  /// (ata de 02/10: o relatório chega com o agendado preenchido e o
  /// profissional troca se foi outro). Nulo = o mesmo do pedido.
  servicoRealizadoId String?
  servicoRealizado   Servico? @relation("ServicoRealizadoNoRelatorio", fields: [servicoRealizadoId], references: [id])

  /// Serviços do catálogo que o profissional executou ALÉM do agendado, com
  /// a quantidade de cada um. É a versão estruturada de `servicosAdicionais`:
  /// o texto livre continua para o que não cabe no catálogo, mas o que cabe
  /// vira linha aqui, e é a linha que o pós-venda consegue transformar em valor.
  adicionais RelatorioServicoAdicional[]

  @@index([profissionalId])
  @@index([aprovadoEm])
}

/// O comprovante de um recebimento no ato (Pix ou cartão). Guardado no banco,
/// em tabela própria, para que listar relatórios nunca carregue o arquivo; é
/// servido por uma rota que confere quem está pedindo. Limite de 3 MB.
model ComprovanteRecebimento {
  id String @id @default(cuid())

  relatorioId String               @unique
  relatorio   RelatorioAtendimento @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  nome     String
  tipo     String
  tamanho  Int
  dados    Bytes
  criadoEm DateTime @default(now())
}

/// Um serviço a mais num relatório. Declarado por quem atendeu e conferido
/// pela central na aprovação — a presença aqui NÃO altera o valor do pedido
/// nem o repasse sozinha.
model RelatorioServicoAdicional {
  id String @id @default(cuid())

  relatorioId String
  relatorio   RelatorioAtendimento @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])

  quantidade Int @default(1)

  /// O mesmo serviço duas vezes no mesmo relatório é uma linha com quantidade
  /// maior, não duas linhas.
  @@unique([relatorioId, servicoId])
  @@index([servicoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Financeiro
// ─────────────────────────────────────────────────────────────────────────────

enum StatusRepasse {
  /// Atendimento realizado, relatório entregue, mas ainda não conferido pela
  /// equipe. Não entra no "a pagar" — em campo o procedimento muda, e pagar
  /// antes de alguém olhar é pagar o que a clínica ainda vai contestar.
  AGUARDANDO_APROVACAO
  PENDENTE
  PAGO
  CANCELADO
}

/// O que a Hemoderi deve ao profissional por um atendimento realizado.
/// Um repasse por pedido, e não um total por mês, porque a conferência que o
/// profissional faz é atendimento a atendimento — o total só fecha a
/// discussão se der para abrir linha a linha.
/// Pedido de agendamento feito por quem ainda NÃO tem cadastro.
///
/// Existe separado de Pedido de propósito. A clínica é o escopo inteiro do
/// sistema — preço, sala, fatura, portal —, e um pedido sem clínica não tem
/// como ser alocado nem cobrado. Deixar isso entrar direto na esteira
/// encheria a fila de trabalho de registros que a operação não consegue
/// executar.
///
/// Aqui é uma antessala: a equipe recebe, confere, e vincula ao cadastro
/// certo (pelo telefone) ou cria a clínica na hora. Só então vira Pedido.
model SolicitacaoPublica {
  id String @id @default(cuid())

  /// O telefone é a chave de verdade deste fluxo: é por ele que a equipe
  /// acha a clínica na base e é o que o WhatsApp usa para conversar.
  /// Guardado só com dígitos, para casar independente da formatação.
  telefone    String
  solicitante String
  email       String?
  /// Como a pessoa chamou a própria clínica. Texto livre porque ela ainda
  /// não é um cadastro — vira um quando a equipe vincular.
  clinicaNome String

  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])

  /// Preferência, não reserva: sem clínica definida não dá para conferir sala
  /// nem equipamento, então prometer horário aqui seria prometer o que a
  /// operação ainda não sabe se cumpre.
  dataDesejada    DateTime
  horarioDesejado String

  doutorNome   String?
  pacienteNome String?
  observacoes  String?

  /// Onde o atendimento acontece — obrigatório desde a ata de 21/09. Vem do
  /// CEP, digitado no navegador de quem pede: número e complemento ficam
  /// livres, o resto a consulta preenche. Quando a solicitação nasce um
  /// cadastro novo (ver `clinicaId`), este é o endereço que a Clínica herda.
  cep             String
  endereco        String
  numero          String?
  complemento     String?
  bairro          String
  cidade          String
  uf              String
  pontoReferencia String?

  status StatusSolicitacao @default(NOVA)

  /// Desde a ata de 21/09, já nasce preenchido: o próprio formulário público
  /// identifica a clínica, por login de quem já é cliente ou por cadastro
  /// novo criado na hora (ver solicitarPublico, em actions/publico.ts).
  /// Nulo só sobra em solicitação anterior a essa mudança — a equipe ainda
  /// tria essas à mão. pedidoId nasce quando a solicitação vira agendamento.
  clinicaId String?
  clinica   Clinica? @relation(fields: [clinicaId], references: [id])
  pedidoId  String?  @unique
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])

  motivoRecusa String?

  criadaEm     DateTime  @default(now())
  tratadaEm    DateTime?
  tratadaPorId String?

  @@index([status, criadaEm])
  @@index([telefone])
}

enum StatusSolicitacao {
  /// Chegou e ninguém olhou ainda — é a fila de trabalho.
  NOVA
  /// Virou agendamento de verdade, vinculada a uma clínica.
  VINCULADA
  /// Recusada (trote, fora de área, serviço que a operação não faz).
  RECUSADA
}

/// A nota que a clínica dá ao atendimento depois que ele acontece.
///
/// Existe porque com ~60 prestadores a equipe não consegue acompanhar a
/// qualidade de cada um olhando a esteira: a diferença entre o profissional
/// que a clínica quer de volta e o que ela evita só aparece quando alguém
/// pergunta — e pergunta sempre, no mesmo formato.
///
/// Quem responde é a clínica contratante, não o paciente. É ela que contrata
/// a Hemoderi, e é a percepção dela que decide se o contrato continua.
model Avaliacao {
  id String @id @default(cuid())

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  /// Quem atendeu e quem avaliou ficam gravados aqui, além de estarem no
  /// pedido: a média por profissional é a consulta que a equipe roda o tempo
  /// todo, e passar por um join no pedido para cada linha é o que faz a tela
  /// de 60 prestadores ficar lenta.
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id])

  /// De 1 a 5. O limite é reforçado na action; aqui fica Int porque nenhum
  /// banco guarda "estrela" — e uma escala que um dia vire 1-10 não deve
  /// exigir migração de tipo.
  nota Int

  /// Opcional de propósito. Exigir texto derruba a taxa de resposta, e uma
  /// nota sem comentário ainda é informação; um comentário forçado é ruído.
  comentario String?

  criadoPorId String?
  criadoPor   Usuario? @relation("AvaliacaoCriadaPor", fields: [criadoPorId], references: [id])

  /// Definitiva — a ata de 21/09 decidiu que a clínica não corrige a própria
  /// avaliação, para a nota não virar objeto de negociação depois do fato
  /// (avaliarAtendimento recusa reenvio). `atualizadaEm` nunca diverge de
  /// `criadaEm` na prática; sobra por simetria com o resto do schema.
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@index([profissionalId])
  @@index([clinicaId, criadaEm])
  @@index([nota])
}

model Repasse {
  id String @id @default(cuid())

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  /// Mês de referência "YYYY-MM". Nasce do dia do atendimento, não do dia em
  /// que o relatório foi enviado: relatório atrasado não empurra o custo para
  /// o mês seguinte.
  competencia String

  valorCentavos Int
  status        StatusRepasse @default(PENDENTE)
  pagoEm        DateTime?
  comprovante   String?
  observacoes   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([profissionalId, competencia])
  @@index([status, competencia])
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

/// O que a clínica deve à Hemoderi no mês. Fechada a partir dos pedidos
/// REALIZADOS da competência — a falta não entra porque não houve serviço a
/// cobrar, salvo negociação lançada à parte.
model Fatura {
  id     String @id @default(cuid())
  numero Int    @unique

  clinicaId String
  clinica   Clinica @relation(fields: [clinicaId], references: [id])

  competencia   String
  valorCentavos Int    @default(0)

  emitidaEm   DateTime     @default(now())
  vencimento  DateTime
  status      StatusFatura @default(ABERTA)
  pagaEm      DateTime?
  observacoes String?

  atualizadaEm DateTime @updatedAt

  /// Desconto concedido, em centavos. Preenchido quando um cupom é aplicado —
  /// o valor da fatura continua bruto; o líquido = valorCentavos - descontoCentavos.
  descontoCentavos Int @default(0)

  pedidos    Pedido[]
  aplicacoes AplicacaoCupom[]
  cobrancas  CobrancaPix[]

  @@unique([clinicaId, competencia])
  @@index([status, vencimento])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cupons de desconto
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo do desconto: percentual sobre o valor do serviço, ou valor fixo em
/// centavos. Os dois existem porque a operação pratica os dois: "10% para quem
/// retorna em 30 dias" e "R$ 50 de cortesia por atraso" são regras reais que
/// não cabem no mesmo formato.
enum TipoDesconto {
  PERCENTUAL
  VALOR_FIXO
}

/// Cupom de desconto criado pela equipe da Hemoderi.
///
/// Nasceu de decisão do André: a operação quer oferecer desconto como
/// ferramenta comercial e de pós-venda — cortesia por atraso, incentivo de
/// retorno, campanha de indicação. O cupom é aplicado no momento da cobrança
/// (esteira do faturamento, pós-venda), não no agendamento: o serviço tem
/// preço cheio, e o desconto é uma redução sobre a cobrança já gerada.
///
/// Configurável pela equipe: tipo (% ou R$), serviços elegíveis (um, vários
/// ou todos), validade por data e/ou por quantidade de usos.
model CupomDesconto {
  id     String @id @default(cuid())
  /// Código digitável — caixa-insensível, sem espaço, único.
  codigo String @unique

  descricao String?

  tipo  TipoDesconto
  /// % quando PERCENTUAL (ex: 10 = 10%), centavos quando VALOR_FIXO.
  valor Int

  /// Serviços elegíveis. Vazio = todos os serviços. É um array de ids de
  /// Servico — sem relação formal porque a elegibilidade não é integridade
  /// referencial (excluir um serviço não invalida o cupom, só encolhe o
  /// alcance, e recriar o serviço com outro id é outra oferta).
  servicoIds String[]

  /// Validade por data — nulo = sem limite de data.
  validoAte DateTime?

  /// Quantas vezes o cupom pode ser usado no total. Nulo = ilimitado.
  limiteUsos     Int?
  /// Contador de usos efetivos (aplicados em fatura). O cupom está esgotado
  /// quando limiteUsos != null e usosRealizados >= limiteUsos.
  usosRealizados Int  @default(0)

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  aplicacoes AplicacaoCupom[]

  @@index([codigo])
  @@index([ativo, validoAte])
}

/// Registro de cada vez que um cupom foi aplicado a uma fatura. Existe
/// separado do campo na fatura porque: (a) a auditoria precisa saber qual
/// cupom foi usado, quando e por quem, (b) o contador de usos do cupom
/// depende de contar estas linhas, e (c) reverter a aplicação é zerar na
/// fatura e marcar aqui como revertido, sem perder o rastro.
model AplicacaoCupom {
  id String @id @default(cuid())

  cupomId String
  cupom   CupomDesconto @relation(fields: [cupomId], references: [id])

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id])

  /// Quanto foi efetivamente descontado, em centavos. Pode ser menor que o
  /// valor nominal do cupom quando o desconto ultrapassa o valor da fatura.
  descontoCentavos Int

  aplicadoEm    DateTime @default(now())
  aplicadoPorId String?

  @@index([cupomId])
  @@index([faturaId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cobranças Pix (Santander)
// ─────────────────────────────────────────────────────────────────────────────

enum StatusCobrancaPix {
  /// QR Code gerado, aguardando pagamento.
  ATIVA
  /// Paga pelo cliente — confirmação veio do webhook ou consulta.
  CONCLUIDA
  /// Expirou sem pagamento.
  EXPIRADA
  /// Cancelada pela equipe antes do pagamento.
  CANCELADA
}

/// Uma cobrança Pix (cob) gerada via API do Santander para uma fatura.
///
/// André decidiu: todas as cobranças serão via Pix pelo Santander. A cobrança
/// nasce quando o pós-venda (Stephanie) gera a cobrança na esteira do
/// faturamento — depois que a fatura da clínica é fechada e o cupom (se
/// houver) já foi aplicado.
///
/// O sistema gera uma cobrança com vencimento (cobv) via API Pix do
/// Santander, que devolve o QR Code e o código copia-e-cola. A equipe
/// compartilha com a clínica (WhatsApp), e o webhook confirma o pagamento.
model CobrancaPix {
  id String @id @default(cuid())

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id])

  /// Identificador da cobrança no Santander (txid). Único, gerado pelo
  /// sistema no formato que o BACEN exige (26-35 alfanuméricos).
  txid String @unique

  /// Valor em centavos — pode diferir do valor da fatura se houve desconto.
  valorCentavos Int

  status StatusCobrancaPix @default(ATIVA)

  /// O payload do QR Code (BRCode / EMV). É o que gera a imagem do QR.
  qrCode      String?
  /// Código copia-e-cola — o texto que o cliente cola no app do banco.
  copiaECola  String?
  /// URL da imagem do QR Code retornada pela API.
  imagemQrUrl String?

  /// Chave Pix da Hemoderi (recebedora).
  chavePix String

  /// Vencimento da cobrança.
  vencimento DateTime

  /// End-to-end ID do pagamento, preenchido pelo webhook/consulta.
  endToEndId String?
  pagoEm     DateTime?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  @@index([faturaId])
  @@index([status])
  @@index([txid])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrações e rastro
// ─────────────────────────────────────────────────────────────────────────────

enum TipoMensagem {
  CONFIRMACAO // pedido confirmado com a clínica
  ALOCACAO // profissional avisado de que assumiu o atendimento
  LEMBRETE // véspera do atendimento
  RESULTADO // realizado / faltou
}

enum StatusMensagem {
  PENDENTE
  ENVIADA
  FALHA
  CANCELADA
}

/// Fila de saída dos disparos de WhatsApp.
///
/// A mensagem é gravada ANTES de ser enviada, e não depois: assim um envio
/// que falha fica visível para reenvio, e um lembrete já gravado não é
/// duplicado se a rotina rodar duas vezes. É também o rastro que responde
/// "avisamos essa clínica?" sem depender do histórico do aparelho.
model MensagemWhatsapp {
  id String @id @default(cuid())

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tipo         TipoMensagem
  destinatario String // telefone em dígitos, com DDI
  texto        String

  status       StatusMensagem @default(PENDENTE)
  agendadaPara DateTime?
  enviadaEm    DateTime?
  erro         String?

  criadaEm DateTime @default(now())

  @@unique([pedidoId, tipo])
  @@index([status, agendadaPara])
}

enum SistemaExterno {
  PIPEDRIVE
  GOOGLE_AGENDA
  WHATSAPP
  SANTANDER
}

/// Log das chamadas a sistemas de terceiros. Existe porque falha de
/// integração é silenciosa por natureza: sem registro, ninguém descobre que
/// o Google Agenda parou de sincronizar até alguém aparecer na clínica errada.
model SincronizacaoExterna {
  id String @id @default(cuid())

  sistema    SistemaExterno
  entidade   String // "Pedido"
  entidadeId String
  acao       String // "criar-evento", "marcar-ganho"

  sucesso    Boolean
  referencia String? // id devolvido pelo sistema externo
  erro       String?
  criadaEm   DateTime @default(now())

  @@index([sistema, criadaEm])
  @@index([entidade, entidadeId])
}

/// Rastro de quem mexeu no que mexe em dinheiro ou compromisso: mudança de
/// status de pedido, alocação, baixa de repasse e de fatura.
model RegistroAuditoria {
  id String @id @default(cuid())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  entidade   String
  entidadeId String
  acao       String
  detalhe    String?

  criadoEm DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}
