# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Conexão da aplicação: use a URL COM "-pooler" no host.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/hemoderi?sslmode=require"

# A MESMA conexão, sem o "-pooler". Use esta ao rodar `prisma migrate`: pelo
# pooler o advisory lock do Migrate fica preso numa conexão do PgBouncer e a
# migration trava com timeout.
#   DATABASE_URL="$DATABASE_URL_UNPOOLED" npx prisma migrate dev
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/hemoderi?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3003"

# ── Integrações (Fase 4) ─────────────────────────────────────────────────────
# Sem estas variáveis o sistema opera normalmente: as integrações ficam
# desligadas e registram a intenção em SincronizacaoExterna, em vez de falhar.

# PipeDrive — usado só para marcar o negócio como ganho ao fim do processo.
# O histórico comercial continua no PipeDrive, por decisão do cliente.
PIPEDRIVE_API_TOKEN=""
PIPEDRIVE_DOMINIO=""

# Google Agenda — conta de serviço com acesso à agenda da equipe.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_AGENDA_ID=""

# WhatsApp — a central de atendimento (Dilon Zap) é quem envia; aqui fica só
# o endpoint que recebe a mensagem já montada pela fila.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Chave que autoriza a rotina de lembretes (cron da Vercel) a rodar.
CRON_SECRET=""
