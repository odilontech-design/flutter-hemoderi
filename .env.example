# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Conexão da aplicação: use a URL COM "-pooler" no host.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/hemoderi?sslmode=require"

# A MESMA conexão, sem o "-pooler". O schema declara isto como `directUrl`,
# e é o que o Prisma usa sozinho em qualquer `migrate` — pelo pooler, o
# advisory lock do Migrate fica preso numa conexão do PgBouncer e trava. Sem
# esta variável, o build da Vercel trava na primeira migration em produção
# (o `prebuild` do package.json roda `migrate deploy` a cada build).
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/hemoderi?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3003"

# ── Configuração inicial de produção ──────────────────────────────────────────
# Só é preciso em produção, e só até o primeiro acesso ser criado. Autoriza
# GET/POST /api/setup, que carrega o catálogo real e cria o primeiro usuário
# interno sem precisar de terminal — a rota se tranca sozinha assim que existe
# algum usuário INTERNO. Gere com: openssl rand -hex 24
SETUP_SECRET=""

# ── Dados de demonstração ────────────────────────────────────────────────────
# Autoriza /api/demo, que preenche o sistema com clínicas, profissionais,
# agenda, relatórios e um mês faturado — para apresentar as telas cheias antes
# de a operação real existir. Tudo que ela cria tem id começando em "demo-", e
# a própria tela apaga exatamente isso quando a apresentação acabar.
#
# Diferente de SETUP_SECRET, esta rota NÃO se tranca sozinha (montar e limpar
# podem precisar ser repetidos). Tire a variável do ambiente quando terminar.
# Gere com: openssl rand -hex 24
DEMO_SECRET=""

# ── Integrações (Fase 4) ─────────────────────────────────────────────────────
# Sem estas variáveis o sistema opera normalmente: as integrações ficam
# desligadas e registram a intenção em SincronizacaoExterna, em vez de falhar.

# PipeDrive — cria o negócio quando o pedido nasce e marca como GANHO quando
# o atendimento é realizado. O histórico comercial continua no PipeDrive, por
# decisão do cliente (14/09); este sistema só escreve essas duas coisas.
PIPEDRIVE_API_TOKEN=""
PIPEDRIVE_DOMINIO=""
# Opcionais — sem eles o sistema usa os padrões da conta PipeDrive e escreve
# o número do pedido só no título do negócio, não num campo à parte.
# PIPEDRIVE_CAMPO_NUMERO_PEDIDO=""   # chave (hash) do campo personalizado
# PIPEDRIVE_ID_FUNIL=""
# PIPEDRIVE_ID_ETAPA=""

# Google Agenda — conta de serviço que publica o atendimento na agenda de
# quem vai atender, para o compromisso aparecer no celular DELE.
#
# Como obter, uma vez só:
#   1. console.cloud.google.com → novo projeto → ative a "Google Calendar API".
#   2. Credenciais → Conta de serviço → Chaves → Adicionar chave (JSON).
#   3. Do JSON baixado: client_email vai em GOOGLE_CLIENT_EMAIL, private_key
#      em GOOGLE_PRIVATE_KEY.
#
# ATENÇÃO à chave: o painel da Vercel guarda o valor em UMA linha, então ela
# entra com "\n" literal no lugar das quebras. É assim mesmo — o sistema
# converte na hora de assinar. Cole o valor exatamente como está no JSON.
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Agenda de reserva, usada só para quem ainda não conectou a agenda dele. Cada
# profissional informa a agenda dele no portal (Disponibilidade → Minha agenda
# do Google) depois de compartilhá-la com o GOOGLE_CLIENT_EMAIL acima dando
# "Fazer alterações nos eventos". Sem esta variável e sem agenda conectada, a
# integração simplesmente não publica nada — nada quebra.
GOOGLE_AGENDA_ID=""

# WhatsApp — a central de atendimento (Dilon Zap) é quem envia; aqui fica só
# o endpoint que recebe a mensagem já montada pela fila.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Chave que autoriza a rotina de lembretes (cron da Vercel) a rodar.
CRON_SECRET=""
